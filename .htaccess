Options -Indexes

<IfModule mod_authz_core.c>
    <FilesMatch "(^\.|^(?:artisan|composer\.(?:json|lock|phar)|phpunit\.xml|vite\.config\.js|package(?:-lock)?\.json)$|\.(?:env|log|sql|sqlite|bak|backup|ini|ya?ml|lock)$)">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect www to non-www
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

    # Prevent direct access to /public/ in the URL
    RewriteCond %{THE_REQUEST} /public/([^\s?]*) [NC]
    RewriteRule ^ %1 [L,NE,R=301]

    # Only the public directory is a web entry point.
    RewriteRule ^(?:app|bootstrap|config|database|resources|routes|tests|vendor)(?:/|$) - [F,L,NC]
    RewriteRule ^public/(.*)$ public/$1 [L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
